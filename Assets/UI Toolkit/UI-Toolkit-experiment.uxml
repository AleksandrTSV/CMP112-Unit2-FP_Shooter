<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement usage-hints="None" name="HealthInfo" style="flex-grow: 1; width: 173px; height: 45px; align-items: stretch; top: 25px; left: 25px; max-height: none; background-color: rgba(255, 200, 195, 0); -unity-background-scale-mode: stretch-to-fill; flex-direction: row; position: absolute;">
        <ui:VisualElement name="Heart1" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Materials/heart.png?fileID=2800000&amp;guid=5fabdd859cd1c084ea4b3a9e30848686&amp;type=3#heart&quot;); -unity-background-image-tint-color: rgb(255, 255, 255); -unity-background-scale-mode: scale-to-fit; visibility: visible;" />
        <ui:VisualElement name="Heart2" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Materials/heart.png?fileID=2800000&amp;guid=5fabdd859cd1c084ea4b3a9e30848686&amp;type=3#heart&quot;); -unity-background-scale-mode: scale-to-fit;" />
        <ui:VisualElement name="Heart3" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Materials/heart.png?fileID=2800000&amp;guid=5fabdd859cd1c084ea4b3a9e30848686&amp;type=3#heart&quot;); -unity-background-scale-mode: scale-to-fit;" />
    </ui:VisualElement>
    <ui:VisualElement name="goalInfo" style="flex-grow: 1; position: absolute; top: 25px; right: 26px; width: 300px; height: 28px; background-color: rgb(201, 8, 0);">
        <ui:VisualElement name="goalFill" style="flex-grow: 1; background-color: rgb(0, 217, 61); position: absolute; top: 0; left: 0; right: 0; bottom: 0; width: 0%;" />
        <ui:Label text="Enemies left:" name="goalLabel" style="position: absolute; left: 25px; font-size: 16px; -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;);" />
    </ui:VisualElement>
    <ui:VisualElement name="Crosshair" style="flex-grow: 1; justify-content: center; align-items: center; margin-top: 40px;">
        <ui:VisualElement name="crosshairImage" style="flex-grow: 1; align-self: center; position: absolute; background-image: url(&quot;project://database/Assets/Materials/Crosshair.png?fileID=2800000&amp;guid=99c0e91ec53b4e5459cc8dd99f5f3ac0&amp;type=3#Crosshair&quot;); width: 32px; height: 32px; top: auto;" />
    </ui:VisualElement>
</ui:UXML>
